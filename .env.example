# ─── Runtime ────────────────────────────────────────────────────────────────────
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Bearer token for /api/admin/*. Required when NODE_ENV=production.
# Send as:  x-admin-token: <token>   or   Authorization: Bearer <token>
ADMIN_TOKEN=

# Directory for the control-plane JSON snapshot. Empty = memory only.
DATA_DIR=

# ─── World Engine ───────────────────────────────────────────────────────────────
# The research loop is opt-in so a developer machine never makes outbound requests
# without being asked.
RESEARCH_ENABLED=false
RESEARCH_INTERVAL_MS=900000

FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=2000000
FETCH_USER_AGENT=CreatorMallBot/0.1 (+https://creatormall.example/bot)
FETCH_MIN_HOST_GAP_MS=2000
RESPECT_ROBOTS=true

# Comma-separated hosts the World Engine is allowed to read.
# Empty = no restriction (development only). Set this in production.
ALLOWED_HOSTS=
